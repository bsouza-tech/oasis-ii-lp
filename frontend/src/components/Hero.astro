---
import OpenLeadButton from './islands/OpenLeadButton.jsx'
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-navy">
  <div
    class="hero-bg absolute inset-0 bg-cover bg-center"
    style="background-image: url('https://wp.oasis2.com.br/wp-content/uploads/2026/04/GN-Oasis_2-Fachada-Diurna_03-scaled.png');"
    role="img"
    aria-label="Fachada do Oásis II Residencial no Bairro da Luz, Nova Iguaçu"
  ></div>
  <div
    class="absolute inset-0"
    style="background: linear-gradient(to bottom, rgba(21,44,65,0.44) 0%, rgba(21,44,65,0.64) 58%, rgba(21,44,65,0.58) 72%, rgba(255,242,229,0.96) 100%);"
  ></div>

  <div class="relative z-10 max-w-3xl mx-auto px-5 py-16 w-full text-center flex flex-col items-center">
    <img
      src="/oasis-logo.png"
      alt="Oásis Residencial"
      class="hero-logo w-36 sm:w-40 md:w-44 h-auto mb-6 drop-shadow-[0_8px_24px_rgba(0,0,0,0.28)]"
    />
    <p class="hero-eyebrow text-orange font-semibold text-xs uppercase tracking-widest mb-3">
      Bairro da Luz · Nova Iguaçu
    </p>
    <h1
      class="hero-headline text-white leading-tight mb-4 max-w-2xl"
      style="font-family: var(--font-display); font-size: clamp(2.4rem, 6vw, 3.8rem); font-weight: 800;"
    >
      As maiores plantas da região.
    </h1>
    <p class="hero-sub text-white/75 text-base leading-relaxed mb-8 max-w-xl">
      Ambientes amplos e layouts inteligentes para sua família viver com mais conforto em Nova Iguaçu.
    </p>
    <div class="hero-cta flex flex-col items-center gap-3">
      <OpenLeadButton client:load size="lg">Agendar uma visita</OpenLeadButton>
      <a
        href="#plantas"
        class="text-sm font-medium text-white/70 underline-offset-4 transition-colors hover:text-white hover:underline"
      >
        Ver plantas e diferenciais
      </a>
    </div>
  </div>
</section>
