{
  "name": "oasis-ii-lp",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w oasis-ii-backend\" \"npm run dev -w oasis-ii-frontend\"",
    "dev:backend": "npm run dev -w oasis-ii-backend",
    "dev:frontend": "npm run dev -w oasis-ii-frontend",
    "build": "npm run build -w oasis-ii-frontend",
    "start:backend": "npm run start -w oasis-ii-backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
